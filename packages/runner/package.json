{
  "name": "@railing/runner",
  "version": "0.1.0",
  "description": "Library-agnostic execution engine. Navigates to a harness URL and executes a component spec against whatever it finds.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "railing": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@railing/report": "workspace:*",
    "@railing/spec": "workspace:*",
    "playwright": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "author": "Amanullah Soomro",
  "homepage": "https://railing.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amansoomro062/railing.git",
    "directory": "packages/runner"
  },
  "bugs": {
    "url": "https://github.com/amansoomro062/railing/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "aria",
    "apg",
    "wcag",
    "testing",
    "playwright",
    "cli",
    "component-library"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "bin": {
      "railing": "./dist/cli.js"
    }
  }
}
