{
  "name": "@handrail/runner",
  "version": "0.1.0",
  "description": "Library-agnostic execution engine. Navigates to a harness URL and executes a component spec against whatever it finds.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "handrail": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly --declarationDir dist",
    "cli": "tsx src/cli.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@handrail/report": "workspace:*",
    "@handrail/spec": "workspace:*",
    "playwright": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
