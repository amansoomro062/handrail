{
  "name": "@railing-dev/spec",
  "version": "0.1.0",
  "description": "Canonical component contracts and accessibility assertions, derived from the W3C ARIA Authoring Practices Guide.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "catalog:"
  },
  "author": "Amanullah Soomro",
  "homepage": "https://railing.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amansoomro062/railing.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/amansoomro062/railing/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "aria",
    "apg",
    "wcag",
    "conformance",
    "component-library",
    "testing"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
