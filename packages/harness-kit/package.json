{
  "name": "@railing/harness-kit",
  "version": "0.1.0",
  "description": "Shared adapter scaffolding. Adapters depend on this so a protocol change is a version bump, not a scavenger hunt through every adapter.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@railing/spec": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "author": "Amanullah Soomro",
  "homepage": "https://railing.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amansoomro062/railing.git",
    "directory": "packages/harness-kit"
  },
  "bugs": {
    "url": "https://github.com/amansoomro062/railing/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "aria",
    "harness",
    "adapter",
    "component-library",
    "react"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  }
}
