    "typecheck": "tsc --noEmit",
    "build": "tsc --emitDeclarationOnly --declarationDir dist",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@handrail/spec": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
