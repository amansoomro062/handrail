{
  "name": "handrail",
  "version": "0.1.0",
  "private": true,
  "description": "Continuous, public accessibility conformance testing for UI component libraries.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "adapter:radix": "pnpm --filter @handrail/adapter-radix run dev",
    "announce": "pnpm --filter @handrail/announce run cli --",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "calibrate": "pnpm handrail run --target _fixture-broken --component dialog --base-url http://localhost:5199 --expect adapters/_fixture-broken/expected.json",
    "check:site": "node scripts/audit-site.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "clean": "rm -rf packages/*/dist adapters/*/dist node_modules/.cache results",
    "fixture:broken": "pnpm --filter @handrail/fixture-broken run dev",
    "handrail": "pnpm --filter @handrail/runner run cli --",
    "notify:bundle": "node scripts/notify-bundle.mjs",
    "restore:docs": "node scripts/restore-docs.mjs",
    "site:build": "pnpm --filter @handrail/web run build",
    "site:dev": "pnpm --filter @handrail/web run dev",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "playwright": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
